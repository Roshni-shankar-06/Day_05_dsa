class Solution:
    def canJump(self, nums: list[int]) -> bool:
        max_reach = 0
        for i, jump in enumerate(nums):
            # If the current index is past the furthest we can reach, we are stuck
            if i > max_reach:
                return False
            # Update the maximum reachable index
            max_reach = max(max_reach, i + jump)
        return True

